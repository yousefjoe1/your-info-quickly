{
  "manifest_version": 3,
  "name": "Copy Your Info Faster",
  "description": "A lightweight Chrome extension that keeps your frequently used personal information at hand — copy and paste instantly while filling forms, applying for jobs, or working online.",
  "version": "1.0.0",
  "action": {
    "default_popup": "index.html",
    "default_title": "Copy Your Info Faster",
    "default_icon": "icons/icon32.png"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}